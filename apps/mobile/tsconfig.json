{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": [
        "../../src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "scripts"
  ]
}
