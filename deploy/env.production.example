# /srv/nepalshop/.env on the server. setup-server.sh creates it with generated secrets; fill in the rest.
# Never commit the real file. After editing, apply with: docker compose up -d   (in /srv/nepalshop)

# --- Domains ---
# The dashboard and API, e.g. app.nepalshop.com (its DNS A record points at this server)
APP_DOMAIN=
# Must equal https://APP_DOMAIN. Also set it as the PUBLIC_URL variable in GitHub (it's built into the app).
PUBLIC_URL=
# Optional: stores at <slug>.BASE_DOMAIN (needs a wildcard DNS record *.BASE_DOMAIN). Same value in GitHub.
BASE_DOMAIN=
# For Let's Encrypt expiry notices
ACME_EMAIL=

# --- Secrets (generated by setup-server.sh; don't change SESSION_SECRET later, it encrypts stored tokens) ---
POSTGRES_PASSWORD=
SESSION_SECRET=

# --- Accounts and legal pages ---
PUBLIC_SIGNUP=false
CONTACT_EMAIL=
LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_NUMBER=

# --- Meta (WhatsApp, Messenger, Instagram): webhook URL is ${PUBLIC_URL}/webhooks/meta ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- TikTok: webhook URL is ${PUBLIC_URL}/webhooks/tiktok ---
TIKTOK_CLIENT_SECRET=
TIKTOK_SEND_URL=https://business-api.tiktok.com/open_api/v1.3/business/message/send/

# --- Optional S3-compatible image storage (otherwise images stay in the server's uploads volume) ---
S3_BUCKET=
S3_PUBLIC_URL=

# --- Tuning (defaults suit a 4-8 GB server) ---
DB_POOL_MAX=20
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=2GB

# --- Off-site backups (strongly recommended): rsync target over SSH, e.g. a Hetzner Storage Box ---
# BACKUP_RSYNC_TARGET=u12345@u12345.your-storagebox.de:nepalshop
BACKUP_RSYNC_TARGET=
BACKUP_SSH_PORT=23
