# Postgres connection (database is created by `bun run migrate` if missing)
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/nepalshop
DB_POOL_MAX=20

PORT=3000
# Set to true behind a reverse proxy (Caddy in production) so rate limits see the real client IP
TRUST_PROXY=false
# Public base URL of this server (used for webhook URLs and secure cookies when https)
PUBLIC_URL=http://localhost:3000
# Long random string; also used to encrypt channel access tokens at rest
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: serve stores at <slug>.<BASE_DOMAIN> (e.g. shop.example.com -> mystore.shop.example.com)
BASE_DOMAIN=

# --- Meta (WhatsApp Cloud API, Messenger, Instagram) ---
# One Meta app for the whole platform. Point its webhook to ${PUBLIC_URL}/webhooks/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- TikTok Business Messaging ---
# Webhook: ${PUBLIC_URL}/webhooks/tiktok
TIKTOK_CLIENT_SECRET=
TIKTOK_SEND_URL=https://business-api.tiktok.com/open_api/v1.3/business/message/send/

# --- Optional S3-compatible image storage (otherwise images go to ./uploads) ---
S3_BUCKET=
S3_PUBLIC_URL=
# Bun reads S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_ENDPOINT, S3_REGION automatically

# --- Accounts ---
# Invite-only by default (trial phase): only platform admins create users. Set to true to reopen public signup.
PUBLIC_SIGNUP=false
# Shown on the sign-up page so people can ask for access (optional)
CONTACT_EMAIL=

# --- Legal pages (/privacy and /data-deletion) ---
# Registered business name, privacy contact email (CONTACT_EMAIL above), and business address
LEGAL_NAME=
BUSINESS_ADDRESS=
# Optional registration number shown after the name, e.g. "ABN 12 345 678 901" or "PAN 123456789"
BUSINESS_NUMBER=
